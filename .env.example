# Copy to .env (never commit .env). The agents use Claude when a key is set, else a local Ollama model.
# ANTHROPIC_API_KEY=
# AEROMIND_LLM=anthropic            # anthropic | ollama | none (rules only)
# AEROMIND_CLAUDE_MODEL=claude-opus-5-5
# AEROMIND_OLLAMA_URL=http://127.0.0.1:11434
# AEROMIND_OLLAMA_MODEL=qwen2.5:3b
