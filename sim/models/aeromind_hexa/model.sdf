<?xml version="1.0"?>
<!--
  AeroMind's airframe: the Aero Sense Hexa-X hexacopter (ArduPilot Hexa-X, FRAME_CLASS 2 / TYPE 1),
  copied from its generated model with the camera, depth, thermal and payload IMU/baro sensors
  removed, since AeroMind only analyses telemetry. Rotor aerodynamics (LiftDrag per blade,
  velocity-controlled joints) are the stock ArduPilot iris's, six of them; rotor_<i>_joint is
  ArduPilot motor i+1. Horizontal drag is linear, 0.9 N per m/s (Hydrodynamics xU/yV below).
-->
<sdf version="1.9">
  <model name="aeromind_hexa">
    <!-- ================= airframe ================= -->
    <link name="base_link">
      <inertial>
        <mass>2.2</mass>
        <inertia><ixx>0.038</ixx><iyy>0.038</iyy><izz>0.05</izz></inertia>
      </inertial>
      <!-- The frame, from its CAD: plates, arms, motor mounts and landing gear in one mesh. -->
      <visual name="frame">
        <geometry><mesh><uri>model://aeromind_hexa/meshes/hexacopter_frame.glb</uri></mesh></geometry>
      </visual>
      <collision name="plates_collision">
        <geometry><box><size>0.402 0.435 0.1</size></box></geometry>
      </collision>
      <!-- The skids' end caps are what touch the ground: aero_sense_bringup/worlds.py
           GEAR_HEIGHT_M is their depth below base_link (tested there). -->
      <collision name="skid_0_collision">
        <pose>0 0.1969 -0.5669 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.0156</radius><length>0.531</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="skid_1_collision">
        <pose>0 -0.1969 -0.5669 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.0156</radius><length>0.531</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <!-- Parts without CAD (render.layout): labelled boxes at their published sizes, the battery
           straps, the camera tray hung from the bottom plate, and the wiring. -->
      <visual name="battery">
        <pose>0.0 0.0 -0.0815 0 0 0.0</pose>
        <geometry><mesh><uri>model://aeromind_hexa/meshes/battery.glb</uri></mesh></geometry>
