    <joint name="rotor_4_joint" type="revolute">
      <child>rotor_4</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_4</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_4</link_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_4_joint</joint_name>
    </plugin>
    <link name="rotor_5">
      <pose>-0.4910364039457767 0.2834999999999999 0.061599999999999995 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-06</ixx><iyy>0.000166704</iyy><izz>0.000167604</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.1</radius><length>0.005</length></cylinder></geometry>
      </collision>
      <!-- motor 6, cw -->
      <visual name="prop">
        <geometry>
          <mesh>
            <uri>model://aeromind_hexa/meshes/iris_prop_cw.dae</uri>
            <scale>1.65 1.65 1</scale>
          </mesh>
        </geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_5_joint" type="revolute">
      <child>rotor_5</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_5</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_5</link_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_5_joint</joint_name>
    </plugin>

    <!-- Air drag on the airframe, horizontal, linear in speed: a multirotor's is mostly rotor drag,
         about 0.35 N per m/s for each kg (2.55 kg here). Without it nothing slowed the drone once it
         stopped controlling position: an EKF failsafe landing with no GPS and no vision coasted
         150 m. Gazebo has no plain body-drag system; Hydrodynamics' linear damping is exactly
         this force (no added mass, no current, no buoyancy). -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1.2041</water_density>
      <xU>-0.9</xU>
      <yV>-0.9</yV>
      <disable_coriolis>true</disable_coriolis>
      <disable_added_mass>true</disable_added_mass>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <!-- Ground truth for the simulator's own use (GPS jammer, drift scoring), not a drone sensor -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/aero_sense_drone/ground_truth</odom_topic>
      <odom_frame>map</odom_frame>
      <robot_base_frame>ground_truth</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>flight_imu_link::imu_sensor</imuName>
      <!-- motor 1 (cw): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="0">
        <jointName>rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- motor 2 (ccw): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="1">
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- motor 3 (cw): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="2">
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- motor 4 (ccw): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="3">
        <jointName>rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- motor 5 (ccw): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="4">
        <jointName>rotor_4_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- motor 6 (cw): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="5">
        <jointName>rotor_5_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
    </plugin>

    <!-- ================= payload ================= -->

    <link name="payload_link">
      <pose>0.0 0.0 -0.1421 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <!-- The real cameras, from their manufacturers' CAD (hardware/cad, tools/step_to_mesh.py).
           Each mesh's origin is the centre of its front face, looking along +X. The simulated
           RGB, depth and thermal sensors below share one optical centre (perception fuses them
           pixel for pixel); the Lepton mesh sits beside the OAK-D, 6 cm of parallax the real
           build will calibrate out. -->
      <visual name="oak_d_pro_w">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry><mesh><uri>model://aeromind_hexa/meshes/oak_d_pro_w.glb</uri></mesh></geometry>
      </visual>
      <visual name="flir_lepton_3_5">
        <pose>0 0.058 0 0 1.5708 0</pose>
        <geometry><mesh><uri>model://aeromind_hexa/meshes/flir_lepton_3_5.glb</uri></mesh></geometry>
      </visual>

      <!-- OAK-D Pro W stereo left (OV9282, global shutter mono): what VIO tracks -->

      <!-- OAK-D Pro W stereo right (OV9282, global shutter mono): what VIO tracks -->
    </link>

    <joint name="payload_joint" type="fixed">
      <parent>base_link</parent>
      <child>payload_link</child>
    </joint>
  </model>
</sdf>